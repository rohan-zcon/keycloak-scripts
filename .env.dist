# Copy this file to .env and fill in real values.
# Used by tenantOnboarding.sh (REALM/CLIENT_ID/CLIENT_SECRET/KEYCLOAK_URL/DBHOST/
# DBPORT/DBUSER/DB per environment - DB password is always prompted at runtime, never
# read from here; the master tenant id is hardcoded in the script, not configured
# here) and by db.js/sqlinit.mjs (DBHOST/DBPASSWORD/DBUSER/DB for uat/prod only).

UAT_DBHOST=
UAT_DBPASSWORD=
UAT_DBUSER=
UAT_DB=
UAT_REALM=
UAT_CLIENT_ID=
UAT_CLIENT_SECRET=
UAT_KEYCLOAK_URL=

PROD_DBHOST=
PROD_DBPASSWORD=
PROD_DBUSER=
PROD_DB=
PROD_REALM=
PROD_CLIENT_ID=
PROD_CLIENT_SECRET=
PROD_KEYCLOAK_URL=

DEV_DBHOST=
DEV_DBPASSWORD=
DEV_DBUSER=
DEV_DB=
DEV_REALM=
DEV_CLIENT_ID=
DEV_CLIENT_SECRET=
DEV_KEYCLOAK_URL=

# Local docker-compose dev environment (see trinitiy-habitat-express/README.md) - DB
# host/port/user/name and the Keycloak URL match that setup's defaults already; only
# the realm/client values (specific to whatever Keycloak dump is restored locally) are
# still placeholders.
LOCAL_DBHOST=localhost
LOCAL_DBPORT=5432
LOCAL_DBPASSWORD=neon
LOCAL_DBUSER=postgres
LOCAL_DB=rehab-tracker-local
LOCAL_REALM=
LOCAL_CLIENT_ID=
LOCAL_CLIENT_SECRET=
LOCAL_KEYCLOAK_URL=http://localhost:8080/auth
